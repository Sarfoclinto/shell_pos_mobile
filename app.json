{
  "expo": {
    "name": "SHELL_SCANNER",
    "slug": "shell_pos_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shellposmobile",
    "userInterfaceStyle": "dark",
    "splash": { "backgroundColor": "#0D1B2E" },
    "assetBundlePatterns": ["**/*"],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shell.scanner",
      "infoPlist": {
        "NSCameraUsageDescription": "SHELL Scanner uses your camera to scan barcodes and QR codes for the POS system."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1B2E",
        "foregroundImage": "./assets/images/android-adaptive-foreground.png",
        "backgroundImage": "./assets/images/android-adaptive-foreground.png",
        "monochromeImage": "./assets/images/android-adaptive-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.shell.scanner",
      "permissions": ["CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D1B2E",
          "dark": {
            "backgroundColor": "#0D1B2E"
          }
        }
      ],
      "expo-barcode-scanner"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
